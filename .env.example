PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/whatsapp_flows

# Pin the Graph API version enabled for your Meta app.
META_GRAPH_BASE_URL=https://graph.facebook.com
META_GRAPH_API_VERSION=v26.0
META_REQUEST_TIMEOUT_MS=30000

# Use a temporary token only for the first test. Use a System User token later.
META_ACCESS_TOKEN=replace_with_your_meta_access_token

# The React UI continues to submit mobileNo. Express resolves that number to
# the WABA account ID required by Meta.
META_WABA_ACCOUNTS_JSON={"919876543210":"1458265205374749"}
